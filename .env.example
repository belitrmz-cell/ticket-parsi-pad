# آدرس و کلید عمومی (publishable/anon) سرویس دیتابیس/احراز هویت (Supabase یا Supabase self-hosted)
VITE_SUPABASE_URL="https://your-supabase-host"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-or-anon-key"
VITE_SUPABASE_PROJECT_ID="your-project-ref"

# همان مقادیر برای سمت سرور
SUPABASE_URL="https://your-supabase-host"
SUPABASE_PUBLISHABLE_KEY="your-publishable-or-anon-key"

# کلید محرمانه سرور (هرگز در مخزن قرار ندهید) — برای عملیات مدیریتی سمت سرور
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# پورت اجرای سرور Node
PORT=3000
